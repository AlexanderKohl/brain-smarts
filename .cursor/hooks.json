{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 15
      }
    ],
    "afterAgentThought": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 15
      }
    ],
    "afterAgentResponse": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 15
      }
    ],
    "postToolUse": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 30
      }
    ],
    "postToolUseFailure": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 15
      }
    ],
    "beforeReadFile": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 30
      }
    ],
    "afterShellExecution": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 30
      }
    ],
    "afterMCPExecution": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 30
      }
    ],
    "afterFileEdit": [
      {
        "command": "python shared/skills/ai-session-log/scripts/cursor_hook_writer.py",
        "timeout": 15
      }
    ]
  }
}
