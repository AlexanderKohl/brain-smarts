{
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git clean -f*)",
      "Bash(git commit * --amend*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit --amend*)",
      "Bash(git commit --no-verify*)",
      "Bash(git filter-branch*)",
      "Bash(git push * --force*)",
      "Bash(git push * --no-verify*)",
      "Bash(git push * -f*)",
      "Bash(git push --force*)",
      "Bash(git push --no-verify*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Edit(**/*.vault)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git commit * --amend*)",
      "PowerShell(git commit * --no-verify*)",
      "PowerShell(git commit --amend*)",
      "PowerShell(git commit --no-verify*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push -f*)",
      "PowerShell(git reset --hard*)",
      "Read(**/*.key)",
      "Read(**/*.pem)",
      "Read(**/*.pfx)",
      "Read(**/*.vault)",
      "Read(**/*.vault.lock)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.cache/PortableAIBrain/**)",
      "Read(~/AppData/Local/PortableAIBrain/**)"
    ],
    "ask": [
      "Bash(git rebase *)",
      "Bash(rm -r *)",
      "Bash(rm -rf *)",
      "PowerShell(Remove-Item * -Recurse*)",
      "PowerShell(git rebase *)"
    ]
  }
}
