#!/bin/sh
# Commit-message check for a shareable repository (SMART-RULE-0008): no personal data in the
# message. Runs only inside a brain; cloned on its own, the commit goes ahead.
top=$(git rev-parse --show-toplevel)
dir="$top"
while [ ! -f "$dir/CONTRACT.md" ] || [ ! -d "$dir/shared" ]; do
  parent=$(dirname "$dir")
  [ "$parent" = "$dir" ] && exit 0
  dir="$parent"
done
py=""
for candidate in python python3 py; do
  if "$candidate" -c "" >/dev/null 2>&1; then py="$candidate"; break; fi
done
[ -z "$py" ] && exit 0
exec "$py" "$dir/shared/skills/repository-preflight/scripts/hooks.py" commit-msg "$1"
